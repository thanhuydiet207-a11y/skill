{
  "schema": 1,
  "limits": {
    "max_agents": 2,
    "max_repair_attempts": 2,
    "max_task_seconds": 1800,
    "max_gate_seconds": 120,
    "max_context_bytes": 24000,
    "max_evidence_bytes": 16000,
    "max_estimated_tokens": 16000,
    "max_output_bytes": 1048576
  },
  "gates": {
    "build": [
      "python3",
      "-m",
      "compileall",
      "-q",
      "omega",
      "tests",
      "benchmarks",
      "omega_cli.py"
    ],
    "tests": [
      "python3",
      "-m",
      "omega.test_runner"
    ],
    "security": [
      "python3",
      "-m",
      "omega",
      "audit",
      "--select",
      ".claude",
      "--select",
      "omega"
    ],
    "regression": [
      "python3",
      "-m",
      "omega",
      "benchmark"
    ]
  },
  "mcp": {
    "enabled": false,
    "servers": []
  }
}
